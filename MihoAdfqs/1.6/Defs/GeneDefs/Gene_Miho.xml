  <GeneDef>
    <defName>Gene_MihoPhase2_Experiment4</defName>
    <label>4号实验产物</label>
    <description>面向元首亲卫的超凡实验模板。携带者仅承受通常伤害的15%，近战闪避率提高50%，并免受受击硬直影响。</description>
    <iconPath>Fc/enp</iconPath>
    <displayCategory>Archite</displayCategory>
    <biostatCpx>6</biostatCpx>
