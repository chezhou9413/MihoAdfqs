<Defs>
  <GeneDef>
    <defName>Gene_MihoThirdEmpireFuhrer</defName>
    <label>元首血统</label>
    <description>第三帝国最高领导者的专属血统标记，同时用于绑定固定外观与动态表情。身体部件受伤时最低保留1点生命值，失血程度不会达到致死阈值，仍会流血、疼痛和倒地。可按美狐的生育规则怀孕，孩子为普通美狐婴儿。</description>
    <iconPath>Fc/enp</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
  </GeneDef>
  <GeneDef>
    <defName>Gene_MihoPhase2_Experiment325</defName>
    <label>325号实验产物</label>
    <description>为第三帝国美狐准备的稳定基因模板。该基因会在头部内维持一枚初始成长进度为15%的佩尔克体。</description>
    <iconPath>Fc/enp</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <geneClass>MihoAdfqs.Genes.Gene_GrantsHediff</geneClass>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
    <modExtensions>
      <li Class="MihoAdfqs.Genes.GeneHediffExtension">
        <hediffDef>MihoPhase2_PerkBody</hediffDef>
        <initialSeverity>0.15</initialSeverity>
      </li>
    </modExtensions>
  </GeneDef>
