<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="MihoPhase2_ApparelClothingBase">
    <defName>MihoPhase2_WineFoxCosplay</defName>
    <label>酒狐cos服</label>
    <description>酒狐cos服。帝国民用服装。</description>
    <graphicData>
      <texPath>apparel/MihoPhase2/WineFoxCosplay/MihoPhase2_WineFoxCosplay</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>800</MaxHitPoints>
      <WorkToMake>400</WorkToMake>
      <Mass>1</Mass>
      <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.6</ArmorRating_Blunt>
      <ArmorRating_Heat>1.2</ArmorRating_Heat>
      <StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
    </statBases>
    <costList>
      <RawPosFlower>20</RawPosFlower>
      <DevilstrandCloth>20</DevilstrandCloth>
    </costList>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <costStuffCount>140</costStuffCount>
    <recipeMaker>
      <researchPrerequisite>MihoPhase2_Research_CivilianApparel</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
        <li>MihoPhase2_Supernova3DPrinter</li>
      </recipeUsers>
    </recipeMaker>
    <comps>
      <li Class="CompProperties_CauseHediff_Apparel">
        <hediff>MihoPhase2_WineFoxCosplayEffect</hediff>
      </li>
    </comps>
    <equippedStatOffsets>
      <PawnBeauty>2</PawnBeauty>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups Inherit="False">
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <wornGraphicPath>apparel/MihoPhase2/WineFoxCosplay/MihoPhase2_WineFoxCosplay</wornGraphicPath>
      <tags Inherit="False">
        <li>MihoPhase2_Civilian</li>
      </tags>
    </apparel>
    <modExtensions>
      <li Class="MihoAdfqs.Phase2.Materials.ApparelMaterialBaseline">
        <material>Cloth</material>
      </li>
    </modExtensions>
  </ThingDef>
  <HediffDef>
    <defName>MihoPhase2_WineFoxCosplayEffect</defName>
    <label>酒狐cos服</label>
    <description>酒狐服装将全局工作速度提高至原来的220%。脱下服装后效果消失。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <WorkSpeedGlobal>2.2</WorkSpeedGlobal>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>