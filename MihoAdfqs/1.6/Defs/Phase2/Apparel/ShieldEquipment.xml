<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="MihoPhase2_ApparelArmorBase">
    <defName>MihoPhase2_HaliviShieldBelt</defName>
    <tickerType>Normal</tickerType>
    <label>哈利维式主用护盾腰带</label>
    <description>全方向护盾，钢铁材质可吸收900点伤害，优先于塔盾承受攻击，超出剩余容量的伤害继续穿透。停止受击10秒后逐渐恢复，从空充满需80秒；破盾后80秒重新充满。护盾容量乘以材料耐久倍率。</description>
    <graphicData>
      <texPath>apparel/MihoPhase2/HaliviShieldBelt/MihoPhase2_HaliviShieldBelt</texPath>
    </graphicData>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>80</costStuffCount>
    <costList>
      <MihoPhase2_IndustrialSteelPlate>10</MihoPhase2_IndustrialSteelPlate>
      <MihoPhase2_Polyethylene>20</MihoPhase2_Polyethylene>
      <ComponentIndustrial>16</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>1200</WorkToMake>
      <Mass>3</Mass>
      <EnergyShieldEnergyMax>0.9</EnergyShieldEnergyMax>
      <EnergyShieldRechargeRate>0.01125</EnergyShieldRechargeRate>
      <StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
    </statBases>
    <comps>
      <li Class="MihoAdfqs.Combat.Armor.CompProperties_ImperialShield">
        <compClass>MihoAdfqs.Combat.Armor.CompImperialShield</compClass>
        <shieldColor>(1,0.63,0.16,0.85)</shieldColor>
        <visualScale>1.85</visualScale>
        <startingTicksToReset>4800</startingTicksToReset>
        <energyOnReset>0.9</energyOnReset>
        <energyLossPerDamage>0.001</energyLossPerDamage>
        <blocksRangedWeapons>false</blocksRangedWeapons>
      </li>
    </comps>
    <apparel>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>MihoPhase2_Research_SpecialForces</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
        <li>MihoPhase2_Supernova3DPrinter</li>
      </recipeUsers>
    </recipeMaker>
    <modExtensions>
      <li Class="MihoAdfqs.Phase2.Materials.ApparelMaterialBaseline">
        <material>Steel</material>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="MihoPhase2_ApparelArmorBase">
    <defName>MihoPhase2_SupernovaShieldGenerator</defName>
    <tickerType>Normal</tickerType>
    <label>超新星级护盾发生器</label>
    <description>全方向护盾，钢铁材质可吸收2200点伤害，优先于塔盾承受攻击，超出剩余容量的伤害继续穿透。停止受击10秒后逐渐恢复，从空充满需50秒；破盾后50秒重新充满。护盾容量乘以材料耐久倍率。</description>
    <graphicData>
      <texPath>apparel/MihoPhase2/SupernovaShieldGenerator/MihoPhase2_SupernovaShieldGenerator</texPath>
    </graphicData>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>300</costStuffCount>
    <costList>
      <MihoPhase2_IndustrialSteelPlate>40</MihoPhase2_IndustrialSteelPlate>
      <MihoPhase2_Polyethylene>20</MihoPhase2_Polyethylene>
      <ComponentIndustrial>22</ComponentIndustrial>
      <ComponentSpacer>8</ComponentSpacer>
      <MihoPhase2_NovaMaterial>1</MihoPhase2_NovaMaterial>
    </costList>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>4200</WorkToMake>
      <Mass>3</Mass>
      <EnergyShieldEnergyMax>2.2</EnergyShieldEnergyMax>
      <EnergyShieldRechargeRate>0.044</EnergyShieldRechargeRate>
      <StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
    </statBases>
    <comps>
      <li Class="MihoAdfqs.Combat.Armor.CompProperties_ImperialShield">
        <compClass>MihoAdfqs.Combat.Armor.CompImperialShield</compClass>
        <shieldColor>(0.3,0.72,1,0.9)</shieldColor>
        <visualScale>2</visualScale>
        <doubleLayer>true</doubleLayer>
        <startingTicksToReset>3000</startingTicksToReset>
        <energyOnReset>2.2</energyOnReset>
        <energyLossPerDamage>0.001</energyLossPerDamage>
        <blocksRangedWeapons>false</blocksRangedWeapons>
      </li>
    </comps>
    <apparel>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>MihoPhase2_Research_Nova</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
        <li>MihoPhase2_Supernova3DPrinter</li>
      </recipeUsers>
    </recipeMaker>
    <modExtensions>
      <li Class="MihoAdfqs.Phase2.Materials.ApparelMaterialBaseline">
        <material>Steel</material>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>MihoPhase2_AssaultTowerShield</defName>
    <label>突击式重型塔盾</label>
    <description>武器槽重型塔盾，抵御正面180°内的远程直射攻击，不拦截近战、爆炸或迫击炮。能量护盾先承受攻击，剩余伤害按塔盾护甲与来袭穿甲判定减伤，再消耗1250点抵消值，耗尽后消耗盾体耐久。闪烁使前方2×3格敌人眩晕5秒，冷却30秒。</description>
    <graphicData>
      <texPath>apparel/MihoPhase2/AssaultTowerShield/MihoPhase2_AssaultTowerShield</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>600</costStuffCount>
    <costList>
      <MihoPhase2_IndustrialSteelPlate>200</MihoPhase2_IndustrialSteelPlate>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>3800</MaxHitPoints>
      <WorkToMake>1600</WorkToMake>
      <Mass>15</Mass>
      <ArmorRating_Sharp>1.8</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.5</ArmorRating_Blunt>
      <ArmorRating_Heat>2</ArmorRating_Heat>
      <StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.5</MoveSpeed>
    </equippedStatOffsets>
    <comps>
      <li Class="MihoAdfqs.Combat.Armor.CompProperties_ArmorReserve">
        <capacity>1250</capacity>
        <towerShield>true</towerShield>
      </li>
    </comps>
    <tools>
      <li>
        <label>盾面</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <researchPrerequisite>MihoPhase2_Research_SpecialForces</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>TableMachining</li>
        <li>FabricationBench</li>
        <li>MihoPhase2_Supernova3DPrinter</li>
      </recipeUsers>
    </recipeMaker>
    <modExtensions>
      <li Class="MihoAdfqs.Phase2.Materials.ApparelMaterialBaseline">
        <material>Steel</material>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>MihoPhase2_KaleviArmorPlate</defName>
    <label>卡列维军用防弹插板</label>
    <description>使用一块为自身穿戴或持有的装备恢复250点抵消值。缺口不足250时仍消耗一块。</description>
    <graphicData>
      <texPath>apparel/MihoPhase2/KaleviArmorPlate/MihoPhase2_KaleviArmorPlate</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>100</WorkToMake>
      <Mass>0.5</Mass>
      <MarketValue>150</MarketValue>
    </statBases>
    <stackLimit>75</stackLimit>
    <costList>
      <MihoPhase2_Polyethylene>80</MihoPhase2_Polyethylene>
      <Steel>20</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>修复装备抵消值</useLabel>
        <useDuration>100</useDuration>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>MihoAdfqs.Combat.Armor.CompUseEffect_RepairArmor</compClass>
      </li>
    </comps>
    <recipeMaker>
      <researchPrerequisite>MihoPhase2_Research_SpecialForces</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>TableMachining</li>
        <li>FabricationBench</li>
        <li>MihoPhase2_Supernova3DPrinter</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>
</Defs>
