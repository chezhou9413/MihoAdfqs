<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <HediffDef>
    <defName>MihoPhase2_CommandAura</defName>
    <label>高效指挥</label>
    <description>处于友方士官十五格范围内，远程武器连发间隔和轮次冷却乘以50%。多个士官不会重复叠加。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120~120</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>
  <ThoughtDef>
    <defName>MihoPhase2_BackgroundMood</defName>
    <thoughtClass>MihoAdfqs.Phase2.Backgrounds.Thought_BackgroundMood</thoughtClass>
    <workerClass>MihoAdfqs.Phase2.Backgrounds.ThoughtWorker_BackgroundMood</workerClass>
    <stages>
      <li>
        <label>往事与生活习惯</label>
        <description>过往经历会持续影响心情。死宅连续离开室内超过十小时后额外降低心情，回到室内后解除。</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>