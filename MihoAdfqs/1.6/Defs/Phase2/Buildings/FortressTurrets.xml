  <ThingDef ParentName="BaseBullet">
    <defName>MihoPhase2_Bullet_Fortress30mm</defName>
    <label>30毫米速射炮弹</label>
    <graphicData>
      <texPath>Thing/MihoPhase2/Projectiles/ImperialShell</texPath>
      <drawSize>(0.5, 0.75)</drawSize>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>40</damageAmountBase>
      <armorPenetrationBase>1.5</armorPenetrationBase>
      <speed>100</speed>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>MihoPhase2_Gun_Fortress30mm</defName>
    <label>30毫米堡垒速射炮</label>
    <description>安装在帝国堡垒上的30毫米速射炮。</description>
    <graphicData>
      <texPath>Building/MihoPhase2/Fortress/MihoPhase2_ImperialFortress_Autocannon30mm</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>0.95</AccuracyMedium>
      <AccuracyLong>0.9</AccuracyLong>
      <RangedWeapon_Cooldown>0.75</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>100</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>MihoAdfqs.Buildings.Defense.Verb_Fortress</verbClass>
        <defaultProjectile>MihoPhase2_Bullet_Fortress30mm</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>80</range>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <burstShotCount>5</burstShotCount>
        <soundCast>Shot_Autocannon</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>0</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>MihoPhase2_Shell_Fortress88mm</defName>
    <label>88毫米高爆炮弹</label>
