<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <HediffDef>
    <defName>MihoPhase2_TreatmentInjectorEffect</defName>
    <label>超新星治疗剂稳定</label>
    <description>快速凝血剂暂时压制了全身出血，为进一步治疗争取时间。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <totalBleedFactor>0</totalBleedFactor>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MihoPhase2_ActivationInjectorEffect</defName>
    <label>超新星神经激发</label>
    <description>神经协调性在两小时内被强化，显著提高移动与战斗反应能力。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>5000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>5.0</MoveSpeed>
          <MeleeDodgeChance>0.03</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <AimingDelayFactor>0.5</AimingDelayFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MihoPhase2_AnalgesicInjectorEffect</defName>
    <label>超新星止痛维持</label>
    <description>六小时内抑制疼痛和出血，并以神经刺激维持清醒。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0</painFactor>
        <totalBleedFactor>0</totalBleedFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>1.0</offset>
            <setMax>1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MihoPhase2_StimulantInjectorEffect</defName>
    <label>超新星战斗兴奋</label>
    <description>十二小时内强制维持清醒并提高机动和战斗反应。该药物具有成瘾与过量风险。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0</painFactor>
        <totalBleedFactor>0</totalBleedFactor>
        <statOffsets>
          <MoveSpeed>3.0</MoveSpeed>
          <MeleeDodgeChance>0.05</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <AimingDelayFactor>0.75</AimingDelayFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>1.0</offset>
            <setMax>1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MihoPhase2_EmergencyInjectorEffect</defName>
    <label>超新星紧急维持</label>
    <description>注射时重建所有断裂肢体并修复伤口。六小时内维持意识、消除疼痛与出血，并以五倍基础速率消耗营养。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0</painFactor>
        <totalBleedFactor>0</totalBleedFactor>
        <hungerRateFactorOffset>4.0</hungerRateFactorOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>1.0</offset>
            <setMax>1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MihoPhase2_HumaneConversionInjectorEffect</defName>
    <label>同化药剂反应</label>
    <description>同化药剂将目标随机转化为帝国美狐或帝国米莉拉，保留身份和记忆。医疗舱可以指定转化种族。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li />
    </stages>
  </HediffDef>
  <ChemicalDef>
    <defName>MihoPhase2_SupernovaStimulantChemical</defName>
    <label>超新星战斗兴奋剂</label>
    <addictionHediff>MihoPhase2_SupernovaStimulantAddiction</addictionHediff>
    <geneOverdoseChanceFactorResist>0.5</geneOverdoseChanceFactorResist>
    <geneOverdoseChanceFactorImmune>0</geneOverdoseChanceFactorImmune>
  </ChemicalDef>
  <NeedDef ParentName="DrugAddictionNeedBase">
    <defName>MihoPhase2_Chemical_SupernovaStimulant</defName>
    <needClass>Need_Chemical</needClass>
    <label>超新星战斗兴奋剂</label>
    <description>对超新星战斗兴奋剂产生依赖后，需要定期补充药物以避免戒断反应。</description>
    <fallPerDay>0.333</fallPerDay>
    <listPriority>45</listPriority>
  </NeedDef>
  <HediffDef ParentName="AddictionBase">
    <defName>MihoPhase2_SupernovaStimulantAddiction</defName>
    <label>超新星战斗兴奋剂成瘾</label>
    <description>长期使用超新星战斗兴奋剂造成的化学依赖。停止用药会引发明显的戒断反应。</description>
    <hediffClass>Hediff_Addiction</hediffClass>
    <chemicalNeed>MihoPhase2_Chemical_SupernovaStimulant</chemicalNeed>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.045</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li />
      <li>
        <label>戒断</label>
        <painFactor>3</painFactor>
        <hungerRateFactorOffset>0.5</hungerRateFactorOffset>
        <statOffsets>
          <RestFallRateFactor>0.3</RestFallRateFactor>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.20</offset>
            <setMax>1</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.50</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>