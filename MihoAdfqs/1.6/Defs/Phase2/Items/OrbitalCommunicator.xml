    <statBases><MaxHitPoints>100</MaxHitPoints><Mass>1</Mass><MarketValue>500</MarketValue><WorkToMake>1200</WorkToMake></statBases>
    <costList><Steel>200</Steel><Plasteel>100</Plasteel><ComponentSpacer>2</ComponentSpacer></costList>
    <recipeMaker><recipeUsers><li>FabricationBench</li></recipeUsers></recipeMaker>
    <comps>
      <li Class="CompProperties_Usable"><useJob>UseItem</useJob><useLabel>联络第三帝国</useLabel><useDuration>60</useDuration></li>
      <li Class="CompProperties_UseEffect"><compClass>MihoAdfqs.Phase2.Communications.CompUseEffect_ImperialCommunicator</compClass></li>
    </comps>
  </ThingDef>
  <ThoughtDef>
    <defName>MihoPhase2_ChallengeLost</defName>
    <workerClass>MihoAdfqs.Phase2.Orbital.ThoughtWorker_OrbitalMobilization</workerClass>
    <stages><li><label>一点都没有挑战性！</label><description>渣渣！一点都没有挑战性！这帮讨厌的家伙！</description><baseMoodEffect>-10</baseMoodEffect></li></stages>
  </ThoughtDef>
</Defs>
