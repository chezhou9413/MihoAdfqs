<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>MihoPhase2_OrbitalCommunicator</defName>
    <label>轨道呼叫用通讯器</label>
    <description>制作配方由元首告知的便携通讯工具，用于联络第三帝国秘书卡黛尔，接受任务和兑换轨道援助。</description>
    <thingClass>ThingWithComps</thingClass>
    <stackLimit>1</stackLimit>
