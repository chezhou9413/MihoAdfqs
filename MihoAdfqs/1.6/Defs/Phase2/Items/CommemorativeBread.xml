<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>MihoPhase2_CommemorativeBread</defName>
    <label>“50万马克的面包”</label>
    <description>一件具有跨时代意义的纪念品，用来回忆美狐们曾经经历的困难年月。它不会腐烂，也不能食用。</description>
    <graphicData>
      <texPath>Thing/MihoPhase2/Food/MihoPhase2_CommemorativeBread</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <statBases>
      <MarketValue>500</MarketValue>
      <Mass>0.5</Mass>
      <Beauty>12</Beauty>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.8</Flammability>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.5</glowRadius>
        <glowColor>(255,205,120,0)</glowColor>
      </li>
    </comps>
    <tradeability>All</tradeability>
  </ThingDef>
  <RecipeDef>
    <defName>MihoPhase2_MakeCommemorativeBread</defName>
    <label>制作“50万马克的面包”</label>
    <description>使用谷物、秘灵花瓣和工业级钢板制作纪念面包。</description>
    <jobString>正在制作纪念面包。</jobString>
    <workAmount>200</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <researchPrerequisite>MihoPhase2_Research_CulturalFamiliarity</researchPrerequisite>
    <recipeUsers>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MihoPhase2_RawWheat</li>
          </thingDefs>
        </filter>
        <count>500</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>RawPosFlower</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MihoPhase2_IndustrialSteelPlate</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <MihoPhase2_CommemorativeBread>1</MihoPhase2_CommemorativeBread>
    </products>
  </RecipeDef>
</Defs>