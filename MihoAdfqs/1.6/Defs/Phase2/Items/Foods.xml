<Defs>
  <ThingDef ParentName="MealBaseIngredientless">
    <defName>MihoPhase2_RefinedFruitPastry</defName>
    <label>精致水果糕点</label>
    <description>帝国糊狐们最喜爱的糕点，无论孩童还是成年人都对它赞不绝口。</description>
    <graphicData>
      <texPath>Thing/MihoPhase2/Food/MihoPhase2_RefinedFruitPastry</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>45</MarketValue>
      <Mass>0.35</Mass>
      <WorkToMake>200</WorkToMake>
      <Nutrition>1.0</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <tasteThought>AteFineMeal</tasteThought>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>3</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <tradeability>Buyable</tradeability>
  </ThingDef>
