<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 蓝色泳衣：任意布料或皮革x50；魅力+3；社交影响力+20% -->
  <ThingDef>
    <defName>Apparel_WhiteSwimsuit</defName>
    <label>白色泳衣</label>
    <description>一件清爽的白色泳衣，穿戴者更具魅力，社交更占优势。</description>

    <!-- 基本属性 -->
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <techLevel>Industrial</techLevel>
    <selectable>true</selectable>
    <drawerType>MapMeshOnly</drawerType>
    <useHitPoints>true</useHitPoints>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <rotatable>false</rotatable>

    <!-- 外观（占位路径，可替换为你的贴图） -->
    <graphicData>
      <texPath>apparel/Swimsuit/White</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1, 1)</drawSize>
      <color>(1,1,1,1)</color>
    </graphicData>

    <!-- 成本：任意皮革或任意布料x50 -->
    <costStuffCount>50</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>

    <!-- 制作：裁缝台 -->
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <recipeUsers>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>240</displayPriority>
    </recipeMaker>

    <!-- 组件 -->
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="ChezhouLib.comp.ApparelAddBodyAddonCompProperties">
        <targetRaces>
          <li>Alien_Miho</li>
        </targetRaces>
      </li>
      <li Class="ChezhouLib.Comp.CompProperties_KindLocked">
        <requiredPawnKindDefName>
          <li>Miho_adfqs</li>
        </requiredPawnKindDefName>
      </li>
      <!-- 可被禁止/放弃（修复 SetForbidden 报错） -->
      <li Class="CompProperties_Forbiddable" />
      <!-- 禁用材料染色（忽略布料/皮革的颜色） -->
      <li Class="ChezhouLib.ClThingComp.ThingCompProperties_DisableStuffColor"/>
    </comps>

    <!-- 基础数值 -->
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToMake>5000</WorkToMake>
      <Mass>2.2</Mass>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <Beauty>4</Beauty>
      <MarketValue>520</MarketValue>
      <!-- 护甲（设定为固定值，避免受材料过度影响） -->
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <ArmorRating_Heat>0.0</ArmorRating_Heat>
      <StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
      <!-- 可选：材料对保暖的影响（留一点材料影响） -->
      <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
    </statBases>

    <!-- 佩戴者属性增益：魅力 +3；社交影响力 +20% -->
    <equippedStatOffsets>
      <PawnBeauty>3</PawnBeauty>
      <SocialImpact>0.2</SocialImpact>
    </equippedStatOffsets>

    <!-- 分类/交易 -->
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <tradeTags>
      <li>MihoThirdEmpireCoat</li>
    </tradeTags>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li>
      </layers>
      <wornGraphicPath>apparel/Swimsuit/White</wornGraphicPath>
      <tags>
        <li>Social</li>
        <li>Clothing</li>
      </tags>
      <canBeDesiredForIdeo>true</canBeDesiredForIdeo>
      <countsAsClothingForNudity>true</countsAsClothingForNudity>
      <defaultOutfitTags>
        <li>Civil</li>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
  </ThingDef>
</Defs>

