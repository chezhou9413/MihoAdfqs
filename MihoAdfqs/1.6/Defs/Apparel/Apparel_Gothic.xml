<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 哥特连衣裙：任意布料x120 + 钢铁x10；魅力+2；护甲（示例棉布）：锐30% 钝30% 热0% -->
  <ThingDef>
    <defName>Apparel_Gothic</defName>
    <label>哥特连衣裙</label>
    <description>一件风格独特的哥特连衣裙，穿戴者更显魅力。</description>

    <!-- 基本属性 -->
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <techLevel>Industrial</techLevel>
    <selectable>true</selectable>
    <drawerType>MapMeshOnly</drawerType>
    <useHitPoints>true</useHitPoints>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <rotatable>false</rotatable>

    <!-- 外观（占位路径，可替换为你的贴图） -->
    <graphicData>
      <texPath>apparel/Gothic/Gothic</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1, 1)</drawSize>
      <color>(1,1,1,1)</color>
    </graphicData>

    <!-- 成本：任意布料x120 + 钢铁x10 -->
    <costStuffCount>120</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <costList>
      <Steel>10</Steel>
    </costList>

    <!-- 制作：裁缝台 -->
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <recipeUsers>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>240</displayPriority>
    </recipeMaker>

    <!-- 组件 -->
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="ChezhouLib.comp.ApparelAddBodyAddonCompProperties">
        <targetRaces>
          <li>Alien_Miho</li>
        </targetRaces>
      </li>
      <li Class="ChezhouLib.Comp.CompProperties_KindLocked">
        <requiredPawnKindDefName>
          <li>Miho_adfqs</li>
        </requiredPawnKindDefName>
      </li>
      <!-- 可被禁止/放弃（修复 SetForbidden 报错） -->
      <li Class="CompProperties_Forbiddable" />
      <!-- 禁用材料染色（忽略布料/皮革的颜色） -->
      <li Class="ChezhouLib.ClThingComp.ThingCompProperties_DisableStuffColor"/>
    </comps>

    <!-- 基础数值 -->
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToMake>15000</WorkToMake>
      <Mass>2.2</Mass>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <Beauty>4</Beauty>
      <MarketValue>520</MarketValue>
      <!-- 护甲（设定为固定值，避免受材料过度影响） -->
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <ArmorRating_Heat>0.0</ArmorRating_Heat>
      <StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
      <!-- 可选：材料对保暖的影响（留一点材料影响） -->
      <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
    </statBases>

    <!-- 佩戴者属性增益：魅力 +2 -->
    <equippedStatOffsets>
      <PawnBeauty>2</PawnBeauty>
    </equippedStatOffsets>

    <!-- 分类/交易 -->
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <tradeTags>
      <li>MihoThirdEmpireCoat</li>
    </tradeTags>
        <apparel>
            <shellRenderedBehindHead>true</shellRenderedBehindHead>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <wornGraphicPath>apparel/Gothic/Gothic</wornGraphicPath>
      <tags>
        <li>Social</li>
        <li>Clothing</li>
      </tags>
      <canBeDesiredForIdeo>true</canBeDesiredForIdeo>
      <countsAsClothingForNudity>true</countsAsClothingForNudity>
      <defaultOutfitTags>
        <li>Civil</li>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
  </ThingDef>
</Defs>
