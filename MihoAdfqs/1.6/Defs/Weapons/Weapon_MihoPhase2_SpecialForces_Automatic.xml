<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="MihoPhase2_GunBase">
    <defName>MihoPhase2_USPSuppressed</defName>
    <label>USP消声手枪</label>
    <description>帝国根据智人种过去的火药武器进行二次现代化改装。该型号配发特战部队，适合在室内环境进行短距离格斗和射击，并加装了消声器。</description>
    <weaponTags>
      <li>ThirdEmpireHighWeapon</li>
      <li>ThirdEmpirePhase2MilitaryWeapon</li>
    </weaponTags>
    <weaponClasses Inherit="False">
      <li>RangedLight</li>
    </weaponClasses>
    <graphicData>
      <texPath>Weapon/MihoPhase2/MihoPhase2_USPSuppressed</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.55, 0.55)</drawSize>
    </graphicData>
    <costList>
      <Steel>80</Steel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <statBases>
      <Mass>1.1</Mass>
      <MarketValue>1300</MarketValue>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>1</AccuracyLong>
      <RangedWeapon_Cooldown>0.1</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>MihoPhase2_Research_SpecialForcesWeapons</researchPrerequisite>
    </recipeMaker>
    <verbs>
      <li Class="MihoAdfqs.Combat.Weapons.VerbProperties_Magazine">
        <verbClass>MihoAdfqs.Combat.Weapons.Verb_Magazine</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MihoPhase2_Projectile_USPSuppressed</defaultProjectile>
        <warmupTime>0.2</warmupTime>
        <range>25</range>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>9</ticksBetweenBurstShots>
        <soundCast>Shot_Autopistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>4</muzzleFlashScale>
        <magazineSize>15</magazineSize>
        <reloadSeconds>1.5</reloadSeconds>
        <secondary>false</secondary>
        <pellets>1</pellets>
        <fireModes>
          <li>点射</li>
          <li>全自动</li>
        </fireModes>
        <preciseBurstTicks>9.0</preciseBurstTicks>
        <accuracyByDistance>
          <points>
            <li>(0, 1)</li>
            <li>(25, 1)</li>
          </points>
        </accuracyByDistance>
      </li>
    </verbs>
  </ThingDef>
  <ThingDef ParentName="MihoPhase2_BulletBase">
    <defName>MihoPhase2_Projectile_USPSuppressed</defName>
    <label>USP消声电荷弹</label>
    <projectile>
      <damageAmountBase>12</damageAmountBase>
    </projectile>
  </ThingDef>
