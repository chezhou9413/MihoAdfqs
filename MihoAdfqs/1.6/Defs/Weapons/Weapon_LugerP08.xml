<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- 鲁格 P08 电荷手枪（单发） -->
    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>Gun_LugerP08_Charge</defName>
        <label>鲁格P08手枪</label>
        <description>一把鲁格P08手枪，经过改造可发射低功率电荷弹。轻便易用，适合近距离自卫。</description>

        <techLevel>Spacer</techLevel>

        <weaponTags>
            <li>ThirdEmpireFuhrer</li>
        </weaponTags>
        <weaponClasses>
            <li>RangedLight</li>
        </weaponClasses>

        <graphicData>
            <texPath>Weapon/luger_p08</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.45, 0.45)</drawSize>
            <color>(1,1,1,1)</color>
        </graphicData>

        <soundInteract>Interact_ChargeRifle</soundInteract>

        <!-- 制作成本：钢铁x45，零部件x1 -->
        <costList>
            <Steel>45</Steel>
            <ComponentIndustrial>1</ComponentIndustrial>
        </costList>

        <statBases>
            <WorkToMake>20000</WorkToMake>
            <Mass>1.2</Mass>
            <AccuracyTouch>0.90</AccuracyTouch>
            <AccuracyShort>0.90</AccuracyShort>
            <AccuracyMedium>0.85</AccuracyMedium>
            <AccuracyLong>0.30</AccuracyLong>
            <RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
            <DeteriorationRate>0.5</DeteriorationRate>
            <Flammability>0.2</Flammability>
            <MarketValue>600</MarketValue>
        </statBases>

        <recipeMaker>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <researchPrerequisite Inherit="False" />
            <workSkill>Crafting</workSkill>
            <effectWorking>Smith</effectWorking>
            <soundWorking>Recipe_Machining</soundWorking>
            <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
            <recipeUsers>
                <li>TableMachining</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>9</Crafting>
            </skillRequirements>
        </recipeMaker>

        <tradeTags>
            <li>WeaponRanged</li>
            <li>MihoThirdEmpireGoods</li>
        </tradeTags>

        <equippedAngleOffset>45</equippedAngleOffset>

        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_LugerP08_Charge</defaultProjectile>
                <warmupTime>0.3</warmupTime>
                <range>18</range>
                <burstShotCount>1</burstShotCount>
                <soundCast>Shot_ChargeRifle</soundCast>
                <soundCastTail>GunTail_Small</soundCastTail>
                <muzzleFlashScale>6</muzzleFlashScale>
            </li>
        </verbs>

        <tools>
            <li>
                <label>枪托</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>6</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>枪管</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>6</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
    </ThingDef>

    <!-- P08 电荷弹（伤害5） -->
    <ThingDef ParentName="BaseBullet">
        <defName>Bullet_LugerP08_Charge</defName>
        <label>电荷弹</label>
        <graphicData>
            <texPath>Things/Projectile/Charge_Small</texPath>
            <drawSize>(0.3, 0.3)</drawSize>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>5</damageAmountBase>
            <speed>70</speed>
            <armorPenetrationBase>0.75</armorPenetrationBase>
            <stoppingPower>0.5</stoppingPower>
        </projectile>
    </ThingDef>
</Defs>

