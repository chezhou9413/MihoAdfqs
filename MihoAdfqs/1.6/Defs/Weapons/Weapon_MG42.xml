<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>Gun_MG42_Charge</defName>
    <label>MG42通用机枪</label>
    <description>帝国根据智人种过去的火药武器进行二次现代化改装，使其适应多用途与各种战场环境，同时也是国防军列装的主要武器。作为单兵轻机枪，它能够向敌人倾泻恐怖的压制火力。</description>
    <techLevel>Spacer</techLevel>
    <weaponTags>
      <li>ThirdEmpireWeapon</li>
      <li>ThirdEmpirePhase2MilitaryWeapon</li>
      <li>LongShots</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <graphicData>
      <texPath>Weapon/mg42</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1, 1)</drawSize>
      <color>(1,1,1,1)</color>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <costList>
      <Steel>265</Steel>
      <ComponentIndustrial>12</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>12</Mass>
      <AccuracyTouch>0.65</AccuracyTouch>
      <AccuracyShort>0.65</AccuracyShort>
      <AccuracyMedium>0.70</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
      <RangedWeapon_Cooldown>0.1</RangedWeapon_Cooldown>
      <DeteriorationRate>0.5</DeteriorationRate>
      <Flammability>0.2</Flammability>
      <MarketValue>4200</MarketValue>
    </statBases>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <researchPrerequisite>MihoPhase2_Research_CommonWeapons</researchPrerequisite>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
    </recipeMaker>
    <tradeTags>
      <li>WeaponRanged</li>
      <li>MihoThirdEmpireGoods</li>
    </tradeTags>
    <equippedAngleOffset>45</equippedAngleOffset>
    <verbs>
      <li Class="MihoAdfqs.Combat.Weapons.VerbProperties_Magazine">
        <verbClass>MihoAdfqs.Combat.Weapons.Verb_Magazine</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <ticksBetweenBurstShots>3</ticksBetweenBurstShots>
        <defaultProjectile>Bullet_MG42_Charge</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>95</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>Shot_Minigun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
        <magazineSize>150</magazineSize>
        <reloadSeconds>10</reloadSeconds>
        <secondary>false</secondary>
        <pellets>1</pellets>
        <fireModes>
          <li>点射</li>
          <li>全自动</li>
        </fireModes>
        <preciseBurstTicks>3.0</preciseBurstTicks>
        <accuracyByDistance>
          <points>
            <li>(0, 0.65)</li>
            <li>(20, 0.65)</li>
            <li>(40, 0.7)</li>
            <li>(95, 0.35)</li>
          </points>
        </accuracyByDistance>
      </li>
    </verbs>
    <tools>
      <li>
        <label>枪托</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>枪管</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_MG42_Charge</defName>
    <label>机枪弹</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>45</damageAmountBase>
      <speed>70</speed>
      <armorPenetrationBase>1.5</armorPenetrationBase>
      <stoppingPower>1.5</stoppingPower>
    </projectile>
  </ThingDef>
</Defs>