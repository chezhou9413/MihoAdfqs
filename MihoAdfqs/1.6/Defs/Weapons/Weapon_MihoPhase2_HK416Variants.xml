  <ThingDef ParentName="MihoPhase2_BulletBase">
    <defName>MihoPhase2_Projectile_HK416Shotgun</defName>
    <label>HK416下挂霰弹</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Shotgun</texPath>
    </graphicData>
    <projectile>
      <damageAmountBase>10</damageAmountBase>
      <stoppingPower>3</stoppingPower>
      <speed>55</speed>
    </projectile>
    <thingClass>MihoAdfqs.Combat.Projectiles.Projectile_AreaPayload</thingClass>
    <modExtensions>
      <li Class="MihoAdfqs.Combat.Projectiles.AreaPayload">
        <width>3</width>
        <height>1</height>
        <orientToFlight>true</orientToFlight>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
